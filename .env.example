# Flask Environment
FLASK_APP=app:create_app
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=dev-secret-key-change-in-prod-radar-2026

# NLP & Clustering Algorithm Config
CLUSTERING_ALGO=bertopic
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Statistical Anomaly Detection Thresholds
ZSCORE_THRESHOLD=2.5
PERCENT_CHANGE_THRESHOLD=50.0
ROLLING_WEEKS=4
MAX_FINDINGS=3
